rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    function role() { return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.role; }
    function staff() { return signed() && role() in ['funcionario', 'admin']; }
    function admin() { return signed() && role() == 'admin'; }

    match /usuarios/{uid} {
      allow read: if signed() && (request.auth.uid == uid || staff());
      allow create: if signed() && request.auth.uid == uid && request.resource.data.role == 'cliente';
      allow update: if (signed() && request.auth.uid == uid && request.resource.data.role == resource.data.role) || admin();
    }

    match /produtos/{id} {
      allow read: if signed();
      allow write: if admin();
    }

    match /pedidos/{id} {
      allow read: if signed() && (resource.data.uid == request.auth.uid || staff());
      allow create: if signed() && request.resource.data.uid == request.auth.uid && request.resource.data.status == 'novo';
      allow update: if staff();
    }
  }
}
